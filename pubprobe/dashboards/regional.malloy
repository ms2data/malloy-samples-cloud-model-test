## artifact { title="Regional performance" tiles=["regional -> by_line", "regional -> by_region"] } dashboard { columns=12 }

source: regional is duckdb.sql("select * from (values ('West', 1200, 'Hardware'), ('East', 950, 'Software'), ('North', 800, 'Hardware'), ('South', 1100, 'Services')) as t(region, amount, line)") extend {
  measure: total_amount is sum(amount)
  measure: deal_count is count()

  view: by_region_base is {
    group_by: region
    aggregate: total_amount
  }

  view: by_line_base is {
    group_by: line
    aggregate: total_amount, deal_count
  }

  # colspan=12
  view: by_region is by_region_base
  # colspan=5
  view: by_line is by_line_base
}
