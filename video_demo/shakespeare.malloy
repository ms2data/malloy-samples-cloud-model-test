// Small demo model over the public Shakespeare word-frequency sample.
source: shakespeare is bigquery.table('bigquery-public-data.samples.shakespeare') extend {

  // Total number of words counted across all works.
  measure: total_word_count is word_count.sum()

  // Number of distinct words (vocabulary size).
  measure: distinct_words is count(word)

  // Average word_count per row (per word/corpus occurrence).
  measure: avg_word_count is word_count.avg()

  // Intentionally broken: references a column that does not exist,
  // to test that the compile-check gate fails the PR.
  measure: broken is nosuchfield.sum()
}
