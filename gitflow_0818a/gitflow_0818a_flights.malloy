// Source over the thelook_ecommerce.order_items table on the bq_demo connection.
source: order_items is bq_demo.table('thelook_ecommerce.order_items') extend {
  // Dimensions
  dimension: is_returned is returned_at != null
  dimension: is_shipped is shipped_at != null
  dimension: is_delivered is delivered_at != null
  dimension: is_cancelled is status = 'Cancelled'

  // Measures
  measure: total_sale_price is sum(sale_price)
  measure: order_item_count is count()
}
